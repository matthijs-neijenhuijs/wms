{
    "name": "openwms/filament-ai-autosuggest-field",
    "description": "Filament form field plugin for AI autosuggestions with multi-model context.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "filament/filament": "^4.0",
        "laravel/ai": "^0.2.5"
    },
    "autoload": {
        "psr-4": {
            "OpenWms\\FilamentAiAutosuggestField\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OpenWms\\FilamentAiAutosuggestField\\AiAutosuggestFieldServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
